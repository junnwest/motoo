# Copy to .env and fill in. Local dev uses docker-compose Postgres on port 5433.
# On Supabase (ORM/Prisma preset): DATABASE_URL = Supavisor pooled (port 6543,
# ?pgbouncer=true), DIRECT_URL = direct (port 5432).
# Locally they're identical (no pooler).
DATABASE_URL="postgresql://motoo:motoo@localhost:5433/motoo?schema=public"
DIRECT_URL="postgresql://motoo:motoo@localhost:5433/motoo?schema=public"

AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_TRUST_HOST="true"

# Korean OAuth — leave blank in dev to hide the provider buttons
AUTH_NAVER_ID=""
AUTH_NAVER_SECRET=""
AUTH_KAKAO_ID=""
AUTH_KAKAO_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# "mock" | "toss" | "nice" — real PGs require sub-merchant credentials
PAYMENT_PROVIDER="mock"
