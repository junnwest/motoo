# Copy to .env and fill in. Local dev uses docker-compose Postgres on port 5433.
# On Supabase (ORM/Prisma preset): DATABASE_URL = Supavisor pooled (port 6543,
# ?pgbouncer=true), DIRECT_URL = direct (port 5432).
# Locally they're identical (no pooler).
DATABASE_URL="postgresql://motoo:motoo@localhost:5433/motoo?schema=public"
DIRECT_URL="postgresql://motoo:motoo@localhost:5433/motoo?schema=public"

AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_TRUST_HOST="true"

# Social login — fill a provider's pair to activate its button (the signup/login
# UI shows a "준비 중 / Soon" badge until then). Each provider auto-provisions a
# fan account on first sign-in. Auth.js callback path is /api/auth/callback/<id>.
#
# GOOGLE — https://console.cloud.google.com → APIs & Services → Credentials →
#   Create Credentials → OAuth client ID → Web application.
#   Authorized redirect URI (dev):  http://localhost:3000/api/auth/callback/google
#   (add the prod URL too when deploying). No business registration needed;
#   in "Testing" consent-screen mode only added test users can sign in.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
#
# NAVER — https://developers.naver.com → 애플리케이션 등록 → API: 네이버 로그인,
#   permissions: 이메일/별명/프로필사진. Register PC Web + Mobile Web environments.
#   Callback URL (dev):  http://localhost:3000/api/auth/callback/naver
#   Personal Naver account is fine (no 사업자등록). Until Naver reviews (검수) the
#   app, only testers added under 멤버관리 can log in — enough for dev/demo.
AUTH_NAVER_ID=""
AUTH_NAVER_SECRET=""
#
# KAKAO — live since 2026-09-03. https://developers.kakao.com → 카카오 로그인,
#   동의항목: 닉네임/프로필 선택, 카카오계정(이메일) 필수. Generate and activate a
#   Client Secret. Turned out not to need a Biz App or 사업자등록 as configured.
AUTH_KAKAO_ID=""
AUTH_KAKAO_SECRET=""

# "mock" | "toss" | "nice" — real PGs require sub-merchant credentials
PAYMENT_PROVIDER="mock"

# Identity verification (본인인증) for onboarding's age/payment gate.
# "mock" | "nice" | "pass" — real 본인확인기관 adapters need a merchant contract.
VERIFICATION_PROVIDER="mock"

# Transactional email — verification, password reset, email change.
# "mock" | "resend". The mock prints the message (link included) to the server
# log, which is fine in dev and is an outage in production: donating requires a
# confirmed address, so a mailed link nobody receives is a gate nobody can pass.
#
# RESEND — https://resend.com → add themotoo.com as a domain, publish the DNS
#   records it gives you (DKIM + SPF; DMARC recommended), wait for it to verify,
#   then create an API key. No 사업자등록 needed. The from-address must be on
#   the verified domain or every send returns 403.
EMAIL_PROVIDER="mock"
RESEND_API_KEY=""
# Optional. Defaults to "motoo <no-reply@themotoo.com>".
EMAIL_FROM=""

# Mock 본인인증 knobs (dev only; both are ignored by a real adapter).
#   VERIFICATION_MOCK_MINOR=1   → the mock returns a minor, so the guardian
#     consent path is reachable at all.
#   VERIFICATION_MOCK_PERSON=x  → every verification returns the SAME person, so
#     a second signup is refused as a duplicate. Unset means each account is a
#     different person, which is what ordinary dev work and the seed need.
VERIFICATION_MOCK_MINOR=""
VERIFICATION_MOCK_PERSON=""
