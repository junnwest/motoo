// motoo data model.
// Money is ALWAYS integer KRW. Never floats.
//
// The Phase-1 Trust Report thesis (Tier / Backing / Perk / PerkDelivery /
// TrustReport / FoundingMembership and their enums) was retired from the
// product in DECISIONS 2026-08-01 and dropped from the schema once the owner
// confirmed the retirement is permanent (2026-08-06). `Update` survives it:
// it is still read by the home feed and creator pages, and Stage 9 builds the
// authoring UI on it.
//
// Money invariants live in src/lib/mochi.ts and are covered by `pnpm test`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (PgBouncer) for runtime — required on serverless so we
  // don't exhaust Postgres connections. On Neon this is the "-pooler" host.
  url       = env("DATABASE_URL")
  // Direct connection for migrations / `prisma db push` (no pooler).
  directUrl = env("DIRECT_URL")
}

enum Role {
  backer
  streamer
  admin
}

enum StreamerStatus {
  pending
  approved
  suspended
}

// Who can read a creator update. `backers` = anyone holding that creator's
// mochi. The tier-scoped third option went with the Phase-1 Tier model.
enum UpdateVisibility {
  public
  backers
}

// ── Phase 2: mochi-marketplace pivot ─────────────────────────────────────────
// A creator issues their own mochi (prepaid marketplace credit, capped as a soft
// goal); users buy it and spend it in that creator's marketplace. Mochi is
// non-transferable, unspent-refundable, no resale/return (see docs/DECISIONS.md).
// Not a financial product — no investment vocabulary in user-facing copy (spec §2).

enum Gender {
  female
  male
  other
  undisclosed
}

enum MarketplaceItemType {
  digital // Q&A slot, shout-out, song/topic request, priority chat
  access // members-only posts/streams, early access, event tickets
  physical // merch, signed items, letters (needs off-platform fulfillment)
  session // 1:1 time slots (short call / DM)
}

enum OrderStatus {
  pending // placed, awaiting creator fulfillment (off-platform in v1)
  fulfilled // creator marked done
  cancelled // creator cancelled; mochi refunded to the buyer's holding
}

// How a redemption settles.
enum FulfillmentMode {
  instant // completes on redemption — no creator action (e.g. a vote ticket)
  request // needs the creator to act; lands in the pending order list (e.g. a mission)
}

model Streamer {
  id              String         @id @default(cuid())
  handle          String         @unique
  displayName     String
  avatarUrl       String?
  bio             String?
  category        String
  // Phase 2 creator onboarding fields
  creatorType     String? // what kind of creator (게임/버추얼/음악/아트…); free-form for v1
  gender          Gender?
  age             Int?
  // The account (Backer, role=streamer) that owns/operates this creator profile.
  // Null for legacy Phase-1 seeds with no login. One account owns at most one profile.
  ownerId         String?        @unique
  owner           Backer?        @relation("CreatorOwner", fields: [ownerId], references: [id])
  // platformLinks
  chzzk           String?
  soop            String?
  youtube         String?
  twitch          String?
  discordUrl      String?
  fanCafeUrl      String?
  status          StreamerStatus @default(pending)
  /// Who suspended this creator, when, and why. On the row rather than only in
  /// a log, because "why can't I take donations?" has to be answerable, and an
  /// unexplained suspension is indistinguishable from a bug.
  suspendedAt     DateTime?
  suspendedReason String?
  suspendedBy     String? // admin email, from the ADMIN_EMAILS allowlist
  subMerchantId   String?
  avgViewers      Int            @default(0)
  followerCount   Int            @default(0)
  createdAt       DateTime       @default(now())
  approvedAt      DateTime?

  updates Update[]

  // Phase 2 relations
  mochiIssuance    MochiIssuance?
  mochiHoldings    MochiHolding[]
  marketplaceItems MarketplaceItem[]
  orders           Order[]
  follows          Follow[]
  donations        Donation[]

  @@index([status])
  @@index([category])
}

// The universal account record. A plain user has role=backer; a creator account
// has role=streamer and owns a Streamer profile via Streamer.owner. (Named "Backer"
// for Phase-1 continuity; treat it as the account/user table.)
model Backer {
  id              String               @id @default(cuid())
  email           String               @unique
  nickname        String
  handle          String?              @unique // public fan @handle, chosen at onboarding
  // Profile picture: a small square JPEG data URL the user uploads in /settings
  // (motoo has no object storage — see src/lib/imageUpload.ts). Null = the
  // initials monogram. Deliberately NOT carried in the JWT: a data URL would
  // blow past the 4KB session-cookie limit.
  avatarUrl       String?
  currencyBalance Int                  @default(0) // legacy Phase-1 global mochi; dormant — Phase 2 uses per-creator MochiHolding
  role            Role                 @default(backer)
  passwordHash    String? // dev credentials login only
  createdAt       DateTime             @default(now())
  // Session revocation counter. Sessions are stateless JWTs, so signing out can
  // only ask the browser to drop the cookie — the token itself stays valid until
  // it expires, and any request still carrying it gets a working session back
  // (Auth.js re-issues the cookie on every authenticated request). Logout
  // increments this; a token carrying a stale version is rejected. An exact
  // counter rather than an issued-at cutoff, so there's no same-second race
  // between logging out and logging straight back in. See DECISIONS 2026-08-02.
  tokenVersion    Int                  @default(0)
  passwordResets  PasswordResetToken[]
  emailTokens     EmailToken[]
  reports         Report[]
  donations       Donation[]
  refundRequests  RefundRequest[]
  /// Set when the address on the account has been confirmed by clicking a
  /// mailed link. Null means unconfirmed — surfaced, not blocked (see
  /// src/lib/emailVerification.ts).
  emailVerifiedAt DateTime?

  // Account deletion is a scheduled state, not an immediate purge: the user
  // gets a grace period (ACCOUNT_DELETION_GRACE_DAYS) in which signing back in
  // cancels it. Null = not scheduled. The row is only actually destroyed by the
  // purge job once this timestamp is in the past. See src/lib/accountDeletion.ts.
  pendingDeletionAt DateTime?

  // Onboarding — every new user completes this once (creators use /creator/onboarding).
  // Middleware redirects a signed-in, non-onboarded fan to /onboarding.
  onboardedAt      DateTime?
  termsAgreedAt    DateTime? // 필수 약관(이용약관·개인정보) 동의 시각
  marketingConsent Boolean   @default(false) // 선택 마케팅 수신 동의
  // "become a creator" intent, captured durably at signup so it survives OAuth
  // round-trips and long gaps between signup and finishing onboarding. Consumed
  // once by completeOnboarding to route the user to /creator/onboarding.
  creatorIntent    Boolean   @default(false)

  // Identity verification (본인인증) — populated by a VerificationProvider (mock in
  // dev; NICE/PASS in prod). Real age gate for payments; not self-reported.
  verifiedAt        DateTime?
  verifiedName      String?
  birthYear         Int?
  gender            Gender?
  ageVerified       Boolean           @default(false)
  guardianConsent   Boolean? // true once a minor's guardian consent is recorded
  // Proof of that consent. Required to keep, because a consent nobody can
  // evidence is the same as no consent if it is ever questioned. Collected by
  // /guardian-consent; the guardian's own 본인인증 needs 사업자등록, so today
  // this is a recorded declaration, and the page says so rather than implying
  // it was verified.
  guardianConsentAt DateTime?
  guardianName      String?
  guardianRelation  GuardianRelation?
  guardianContact   String?

  // Phase 2 relations
  ownedStreamer Streamer?      @relation("CreatorOwner")
  mochiHoldings MochiHolding[]
  orders        Order[]
  follows       Follow[]
  notifications Notification[]
}

enum GuardianRelation {
  parent
  grandparent
  sibling
  other
}

model Update {
  id            String           @id @default(cuid())
  streamerId    String
  streamer      Streamer         @relation(fields: [streamerId], references: [id], onDelete: Cascade)
  title         String
  body          String
  visibility    UpdateVisibility @default(public)
  publishedAt   DateTime         @default(now())
  viewCount     Int              @default(0)
  reactionCount Int              @default(0)

  @@index([streamerId])
}

// ── Phase 2 models ───────────────────────────────────────────────────────────

// Per-creator mochi issuance config. The creator sets quantity × price as a SOFT
// GOAL/target (e.g. 100 × ₩200 = ₩20,000) — a framing device, not a scarce security
// (see docs/DECISIONS.md). grantedQuantity tracks progress toward the goal. Mochi is
// never sold: a fan donates KRW directly to the creator, and mochi is granted
// afterward as a non-purchased bonus at this rate (see the donation-pivot DECISIONS
// entry) — pricePerMochiKrw reads as "KRW donated to earn 1 bonus mochi."
model MochiIssuance {
  id               String   @id @default(cuid())
  streamerId       String   @unique
  streamer         Streamer @relation(fields: [streamerId], references: [id], onDelete: Cascade)
  pricePerMochiKrw Int // integer KRW donated to earn 1 mochi bonus, AT THE CURRENT TIER
  goalQuantity     Int // bonus-mochi goal at the current tier (the "X left" meter)
  grantedQuantity  Int      @default(0) // granted IN THE CURRENT TIER; resets to 0 on a rate raise
  lifetimeGranted  Int      @default(0) // total mochi ever granted, across all tiers (for stats)
  active           Boolean  @default(true) // creator can pause the donation bonus
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// A user's unspent mochi balance FOR ONE creator, earned as a bonus on donations to
// that creator (never sold — see docs/DECISIONS.md, the donation-pivot entry). Mochi
// is non-transferable and scoped to the issuing creator's marketplace.
// mochiEarnedTotal is lifetime earned (for "supporter" display); balance is what
// remains spendable.
model MochiHolding {
  id               String   @id @default(cuid())
  streamerId       String
  streamer         Streamer @relation(fields: [streamerId], references: [id], onDelete: Cascade)
  backerId         String
  backer           Backer   @relation(fields: [backerId], references: [id], onDelete: Cascade)
  balance          Int      @default(0) // unspent mochi units held for this creator
  mochiEarnedTotal Int      @default(0) // lifetime mochi earned as a donation bonus from this creator
  krwPaidTotal     Int      @default(0) // lifetime KRW donated — the leaderboard/refund ledger
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([streamerId, backerId])
  @@index([streamerId])
  @@index([backerId])
}

// An item in a creator's marketplace, priced in that creator's mochi. Fulfillment
// is off-platform in v1 (creator marks orders fulfilled). stock null = unlimited.
model MarketplaceItem {
  id            String              @id @default(cuid())
  streamerId    String
  streamer      Streamer            @relation(fields: [streamerId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  priceMochi    Int // price in mochi units
  itemType      MarketplaceItemType
  thumbnailKey  String? // curated thumbnail slug (see lib/itemThumbnails); null = itemType default
  // Creator-uploaded 16:9 cover photo, stored as a small JPEG data URL (motoo
  // has no object storage — see src/lib/imageUpload.ts). Null = fall back to the
  // curated thumbnailKey tile. Size is capped on write, not just on the client.
  coverImage    String?
  fulfillment   FulfillmentMode     @default(request) // instant = auto-complete; request = creator acts
  stock         Int? // null = unlimited; otherwise remaining stock is stock - redeemedCount
  redeemedCount Int                 @default(0)
  active        Boolean             @default(true)
  /// Admin takedown, deliberately separate from `active`. `active` is the
  /// creators own switch; if a takedown reused it the creator could simply
  /// turn the item back on. Null = not taken down.
  hiddenAt      DateTime?
  hiddenBy      String? // admin email
  hiddenReason  String?
  sortOrder     Int                 @default(0)
  createdAt     DateTime            @default(now())

  orders Order[]

  @@index([streamerId])
  // Every creator page filters on (streamerId, active), and getAffordableItems
  // ORs over per-creator price bounds with active = true.
  @@index([streamerId, active])
}

// A redemption: a user spends mochi on a marketplace item. Records the order;
// the creator fulfills off-platform and marks status. Cancelling refunds mochi.
model Order {
  id          String          @id @default(cuid())
  streamerId  String
  streamer    Streamer        @relation(fields: [streamerId], references: [id], onDelete: Cascade)
  backerId    String
  backer      Backer          @relation(fields: [backerId], references: [id], onDelete: Cascade)
  itemId      String
  item        MarketplaceItem @relation(fields: [itemId], references: [id])
  mochiSpent  Int // mochi debited for this order (quantity × item price at time of order)
  quantity    Int             @default(1)
  note        String? // buyer note (song title, shout-out text, delivery ref, …)
  status      OrderStatus     @default(pending)
  createdAt   DateTime        @default(now())
  fulfilledAt DateTime?

  @@index([streamerId])
  @@index([backerId])
  @@index([itemId])
  // The Studio's pending queue and a buyer's own history both filter by owner
  // plus status, then order by createdAt.
  @@index([streamerId, status])
  @@index([backerId, status])
}

// A free, in-app "I want to hear from this creator" relationship — distinct from
// MochiHolding (money) and Streamer.followerCount (a dormant Phase-1 seeded
// number for an off-platform follower count, never rendered). Following costs
// nothing, so it's the wider of the two "creators you support" relationships and
// is what fills the home rail for a user who hasn't bought mochi from everyone
// they're interested in yet.
model Follow {
  id         String   @id @default(cuid())
  streamerId String
  streamer   Streamer @relation(fields: [streamerId], references: [id], onDelete: Cascade)
  backerId   String
  backer     Backer   @relation(fields: [backerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([streamerId, backerId])
  @@index([streamerId])
  @@index([backerId])
}

// What triggers a Notification. Kept to events with a clear, unambiguous
// audience (see src/lib/notify.ts for exactly who receives each type).
enum NotificationType {
  order_fulfilled // creator marked your order done
  order_cancelled // creator cancelled your order; mochi was refunded
  new_item // a creator you hold mochi in or follow added a marketplace item
  price_raised // a creator you hold mochi in raised their mochi price (new tier)
  new_update // a creator you hold mochi in or follow posted an update
}

// A notification queued for one Backer. Created outside the money-invariant
// transactions in mochi.ts (see src/lib/notify.ts) — best-effort, never allowed
// to fail the action that triggered it.
model Notification {
  id        String           @id @default(cuid())
  backerId  String
  backer    Backer           @relation(fields: [backerId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  link      String? // where "전체 보기"/clicking the row goes, e.g. /me/mochi
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([backerId, read])
  @@index([backerId, createdAt])
}

/**
 * Fixed-window rate-limit counters. A table rather than Redis: motoo does
 * single-digit RPS and the database is already on every request path, so this
 * avoids a hosted dependency and a secret for no practical gain. Rows are
 * pruned nightly by the same cron that purges deleted accounts.
 * See src/lib/rateLimit.ts.
 */
model RateLimit {
  id          String   @id @default(cuid())
  /// "<kind>:<subject>", e.g. "buy:<backerId>" or "login:<email>"
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@unique([key, windowStart])
  @@index([windowStart])
}

// A single-use, expiring password-reset grant.
//
// Stores a SHA-256 *hash* of the token, never the token itself: the emailed
// value is the only copy, so a leaked database dump cannot be replayed into
// account takeovers. Same reasoning as passwordHash sitting next to it.
//
// Rows are kept after use (usedAt set) rather than deleted, so "this link was
// already used" is answerable — a user clicking an old link deserves that
// message rather than a generic failure. The purge cron sweeps expired rows.
model PasswordResetToken {
  id        String    @id @default(cuid())
  backerId  String
  backer    Backer    @relation(fields: [backerId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // sha256 of the emailed token, hex
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([backerId])
  @@index([expiresAt])
}

// Why an email token needs a purpose: verifying the address already on the
// account and moving the account to a new address are the same mechanism (mail
// a secret, click it, prove control) with one difference — a change carries the
// address it is moving *to*, and that address must not become the account's
// until the click happens. Two tables would have been the same columns twice.
enum EmailTokenPurpose {
  verify // confirm the address already on the account
  change // move the account to `newEmail`, once its owner clicks
}

// Same storage rules as PasswordResetToken: the emailed value is never stored,
// only its SHA-256 hash, and a consumed row is kept (usedAt) so a second click
// can be answered honestly.
model EmailToken {
  id        String            @id @default(cuid())
  backerId  String
  backer    Backer            @relation(fields: [backerId], references: [id], onDelete: Cascade)
  purpose   EmailTokenPurpose
  tokenHash String            @unique // sha256 of the emailed token, hex
  /// Only set for `change`: the address this token would move the account to.
  /// Not unique — two people may both be mid-change to the same address, and
  /// the loser finds out at consume time, where the real uniqueness check is.
  newEmail  String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([backerId])
  @@index([expiresAt])
}

enum ReportTargetType {
  creator
  item
}

enum ReportReason {
  impersonation // pretending to be someone else — the risk auto-approval carries
  scam // took mochi, never delivered
  sexual
  harassment
  other
}

enum ReportStatus {
  open
  actioned // the report led to something (a suspension, an item removed)
  dismissed // reviewed, no action
}

// A user-submitted report about a creator or a marketplace item.
//
// Signed-in only, and one row per (reporter, target): anonymous reporting would
// make the queue a spam surface, and letting one person file the same report
// fifty times would make volume meaningless as a triage signal. Both are
// enforced by the unique index below rather than by the UI.
model Report {
  id         String           @id @default(cuid())
  reporterId String
  reporter   Backer           @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  targetType ReportTargetType
  /// Streamer.id or MarketplaceItem.id depending on targetType. Not a foreign
  /// key: the two targets live in different tables, and a report should outlive
  /// the thing it is about — deleting the item must not erase the evidence.
  targetId   String
  reason     ReportReason
  detail     String?
  status     ReportStatus     @default(open)
  createdAt  DateTime         @default(now())
  reviewedAt DateTime?
  reviewedBy String? // admin email
  resolution String?

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
}

// One row per donation.
//
// Until 2026-08-18 donations existed only as running totals on MochiHolding
// (krwPaidTotal, mochiEarnedTotal), which meant /refund promised something the
// data could not answer: the 7-day 청약철회 window needs a date per donation,
// and "not one mochi from that donation spent" needs to know what that donation
// granted. It also meant a fan had no donation history and no receipt.
//
// Written inside donateMochi's transaction, so a donation row and the credit it
// describes cannot disagree.
model Donation {
  id               String    @id @default(cuid())
  backerId         String
  backer           Backer    @relation(fields: [backerId], references: [id], onDelete: Cascade)
  streamerId       String
  streamer         Streamer  @relation(fields: [streamerId], references: [id], onDelete: Cascade)
  amountKrw        Int
  mochiGranted     Int
  /// The rate at the time. Kept because the creator's rate ratchets, so it
  /// cannot be recovered later — and a receipt that cannot explain its own
  /// arithmetic is not a receipt.
  pricePerMochiKrw Int
  /// The PG idempotency token. Unique, so a retried charge can never produce a
  /// second ledger row for one payment.
  idempotencyKey   String    @unique
  createdAt        DateTime  @default(now())
  refundedAt       DateTime?

  refundRequests RefundRequest[]

  @@index([backerId, createdAt])
  @@index([streamerId, createdAt])
}

enum RefundReason {
  withdrawal // 7-day 청약철회 on a wholly unused donation
  legal // the 법령 carve-out (a minor's payment without guardian consent)
  other
}

enum RefundStatus {
  open
  approved // agreed; the money leg still needs a real PG
  rejected
  refunded // money actually returned
}

// A fan's request to have a donation refunded.
//
// Intake only. /refund states real positions but there was no way to *ask*
// (docs/PRELAUNCH.md #8) — and the money leg genuinely needs the PG, while the
// request and its audit trail do not.
model RefundRequest {
  id                String       @id @default(cuid())
  backerId          String
  backer            Backer       @relation(fields: [backerId], references: [id], onDelete: Cascade)
  donationId        String
  donation          Donation     @relation(fields: [donationId], references: [id], onDelete: Cascade)
  reason            RefundReason
  detail            String?
  /// What the eligibility check said at submission time, kept verbatim. The
  /// window closes and balances move, so re-deriving it during review would
  /// answer a different question than the one the fan was shown.
  eligibleAtRequest Boolean
  status            RefundStatus @default(open)
  createdAt         DateTime     @default(now())
  reviewedAt        DateTime?
  reviewedBy        String?
  resolution        String?

  @@unique([donationId])
  @@index([status, createdAt])
}
